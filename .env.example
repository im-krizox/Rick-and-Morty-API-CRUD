# Variables de entorno para el proyecto Rick and Morty API CRUD
# Copia este archivo como .env y configura los valores

# Clave secreta de Django (genera una nueva para producción)
# Puedes generar una en: https://djecrety.ir/
DJANGO_SECRET_KEY=tu-clave-secreta-aqui

# Modo debug (True para desarrollo, False para producción)
DJANGO_DEBUG=True

# Hosts permitidos (separados por coma, sin espacios)
# Ejemplo: localhost,127.0.0.1,midominio.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
